# Copy this file to .env, edit the required values once, then run:
#   ./setup.sh
#
# Do not commit populated .env files.
#
# Architecture summary:
#   - This server/real host is the K3s control-plane and Ansible runner.
#   - The provisioner creates only worker VMs: worker1 and worker2.
#   - NFS is external and is not joined to Kubernetes.
#   - Redis provides shared OTP/admin state for multi-replica app operation.
#   - Traefik exposes the portal and Grafana through Ingress.
#   - frontend/app.jsx is source; frontend/app.js is generated during build/deploy.
#   - docs/help/ is source; frontend/help/ is generated during build/deploy.

# -----------------------------------------------------------------------------
# Repository / install location
# -----------------------------------------------------------------------------
REPO_URL="https://github.com/psi1703/k8s-ansible.git"
REPO_REF="main"
INSTALL_DIR="/opt/k8s-ansible"
NAMESPACE="otp-relay"

# -----------------------------------------------------------------------------
# Container images
# -----------------------------------------------------------------------------
APP_IMAGE="otp-relay:latest"
MONITOR_IMAGE="otp-monitor:latest"
DEPLOY_MODE="full"

# -----------------------------------------------------------------------------
# Portal service / Ingress
# -----------------------------------------------------------------------------
# Preferred production model:
#   Service remains ClusterIP.
#   Traefik is exposed by MetalLB.
#   Portal access uses a DNS hostname pointing to the Traefik LoadBalancer IP.
#
# Example test-cluster naming:
#   TLS_HOST="srvotptest26.init-db.lan"
#   PORTAL_URL="http://srvotptest26.init-db.lan"
#
# TLS_ENABLED=0 means HTTP ingress.
# TLS_ENABLED=1 means HTTPS ingress and requires a valid TLS_HOST.
# TLS_SELF_SIGNED=1 lets the installer create the TLS secret if missing.
# TLS_SELF_SIGNED=0 means TLS_SECRET_NAME must already exist as a Kubernetes TLS secret.
# Existing self-signed TLS secrets are kept by default. Set TLS_ROTATE_SELF_SIGNED=1 only when intentionally rotating.
SERVICE_TYPE="ClusterIP"
SERVICE_NODE_PORT="30080"
LOADBALANCER_IP=""
INGRESS_ENABLED="1"
TLS_ENABLED="0"
TLS_HOST="CHANGE_ME_PORTAL_HOST"
TLS_SECRET_NAME="otp-relay-tls"
TLS_SELF_SIGNED="1"
TLS_ROTATE_SELF_SIGNED="0"
PORTAL_URL=""

# -----------------------------------------------------------------------------
# App storage: external NFS-backed RWX PVC
# -----------------------------------------------------------------------------
# NFS is external infrastructure. Set NFS_SERVER and NFS_PATH to the real export.
# The Kubernetes cluster consumes the export through the generated PV/PVC.
PVC_STORAGE_CLASS="otp-relay-nfs"
PVC_SIZE="1Gi"
NFS_ENABLED="1"
NFS_SERVER="CHANGE_ME_NFS_SERVER"
NFS_PATH="CHANGE_ME_NFS_EXPORT_PATH"
NFS_STORAGE_CLASS="otp-relay-nfs"
NFS_PV_NAME="otp-relay-data-nfs-pv"
NFS_MOUNT_OPTIONS="nfsvers=4.1"

# -----------------------------------------------------------------------------
# Replicas / scheduling
# -----------------------------------------------------------------------------
# App and Redis should run on worker nodes through node labels.
# Monitor can run on the control-plane/server because it needs host network/ARP access.
REPLICA_COUNT="2"
APP_NODE_SELECTOR_KEY="otp-relay/app-node"
APP_NODE_SELECTOR_VALUE="true"
MONITOR_NODE_SELECTOR_KEY="otp-relay/monitor-node"
MONITOR_NODE_SELECTOR_VALUE="true"
REDIS_NODE_SELECTOR_KEY="otp-relay/redis-node"
REDIS_NODE_SELECTOR_VALUE="true"

# -----------------------------------------------------------------------------
# MetalLB / Traefik LoadBalancer
# -----------------------------------------------------------------------------
# ClusterIP + Ingress uses Traefik. In this project, Traefik is normally exposed
# through MetalLB so browser users can reach the portal and Grafana on the LAN.
#
# LOADBALANCER_IP may be left empty when the installer is allowed to choose a free
# IP from METALLB_IP_RANGE. If set, it must be free on the LAN.
#
# SERVICE_TYPE=LoadBalancer is not the preferred app service model. Keep the app
# Service as ClusterIP and expose through Traefik unless deliberately testing.
REQUIRE_METALLB="0"
INSTALL_METALLB="0"
METALLB_VERSION="v0.15.3"
METALLB_IP_RANGE=""
METALLB_POOL_NAME="otp-relay-pool"

# -----------------------------------------------------------------------------
# Monitor / phone presence
# -----------------------------------------------------------------------------
PHONE_IP="CHANGE_ME_PHONE_IP"
PHONE_INTERFACE="CHANGE_ME_INTERFACE"
PHONE_PING_INTERVAL="10"
PHONE_OFFLINE_THRESHOLD="30"
PHONE_ARP_COUNT="2"
PHONE_ARP_TIMEOUT="2"
MONITOR_METRICS_PORT="9101"

# -----------------------------------------------------------------------------
# Runtime paths inside containers
# -----------------------------------------------------------------------------
OTP_RELAY_DATA_DIR="/app/data"
USERS_EXCEL_PATH="/app/data/users.xlsx"
AUDIT_LOG_PATH="/app/data/audit.log"
CLAIM_EXPIRY_SEC="90"
OTP_DISPLAY_SEC="285"
CONCURRENT_RISK_SEC="30"

# -----------------------------------------------------------------------------
# Secrets
# -----------------------------------------------------------------------------
# Leave SMS_SECRET_TOKEN empty to let setup generate one, or set a strong value manually.
SMS_SECRET_TOKEN=""
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# -----------------------------------------------------------------------------
# Redis HA / shared state
# -----------------------------------------------------------------------------
# Redis is required for multi-replica OTP Relay app operation.
# The app uses Redis for shared OTP queue, pending OTP state, admin sessions, and login-attempt tracking.
REDIS_ENABLED="1"
REDIS_URL="redis://otp-redis-haproxy:6379/0"
REDIS_REQUIRED="1"
REDIS_STORAGE_CLASS="otp-redis-nfs"
REDIS_SIZE="1Gi"
REDIS_SPREAD_RECREATE_PVCS="auto"

# -----------------------------------------------------------------------------
# Installer behavior
# -----------------------------------------------------------------------------
# Repository sync is handled by scripts/sync-repo.sh and the optional systemd timer.
# Repo sync only updates files. It does not deploy, restart pods, apply manifests, or run Helm.
# No GitHub Actions self-hosted runner is required.
RUNTIME_DATA_DIR=""
SKIP_HELP_DOCS_BUILD="0"
GIT_CLEAN="1"
SKIP_REPO_SYNC="auto"
NONINTERACTIVE="0"
DOCKER_BIN=""
DISTRIBUTE_IMAGES_TO_NODES="1"
IMAGE_DISTRIBUTION_PORT="18080"
IMAGE_IMPORTER_IMAGE="redis:7-alpine"

# -----------------------------------------------------------------------------
# Worker VM provisioner inputs
# -----------------------------------------------------------------------------
# No CP_IP exists in this design. The server is the control-plane.
# VM_PASSWORD is required only when provisioning/repairing worker VMs.
BRIDGE_NAME="br0"
HOST_IFACE="CHANGE_ME_HOST_INTERFACE"
HOST_IP_CIDR="CHANGE_ME_HOST_IP_CIDR"
GATEWAY="CHANGE_ME_GATEWAY"
DNS="CHANGE_ME_DNS"
PREFIX="24"
IP_SCAN_PREFIX="CHANGE_ME_IP_PREFIX"
IP_SCAN_START="150"
IP_SCAN_END="199"
AUTO_ASSIGN_IPS="1"
WORKER1_IP=""
WORKER2_IP=""
VM_USER="otp-relay"
VM_PASSWORD=""
VM_RAM_MB="3072"
VM_VCPUS="2"
VM_DISK_GB="20"
WORKER1_NAME="otp-worker1"
WORKER2_NAME="otp-worker2"

# -----------------------------------------------------------------------------
# Observability / Grafana
# -----------------------------------------------------------------------------
# When enabled, the installer deploys kube-prometheus-stack with Helm, then applies
# OTP Relay dashboards, ServiceMonitor resources, Loki/Alloy logging, and Grafana Ingress YAML.
#
# Grafana uses a hostname-based Ingress by default. It shares the Traefik LoadBalancer IP
# with the portal, but uses a different host rule.
#
# Example test-cluster naming:
#   GRAFANA_HOST="grafana-srvotptest26.init-db.lan"
#
# Do not use grafana-test.lan except as a local scratch value.
OBSERVABILITY_NAMESPACE="observability"
OBSERVABILITY_INSTALL_STACK="1"
OBSERVABILITY_STACK_CHART_VERSION="85.0.1"
GRAFANA_HOST="grafana-srvotptest26.init-db.lan"
